{
  "name": "solside",
  "version": "0.1.1",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "npm run build && node --test tests/*.cjs",
    "package:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "entities": "^6.0.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "electron": "^39.0.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.28.2": true
  }
}
